# Production requires trusted HTTPS in front of the loopback-only web port.
APP_ENV=production
APP_COOKIE_SECURE=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
