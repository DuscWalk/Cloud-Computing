# For local Compose only. Replace with randomly generated hexadecimal values.
APP_ENV=development
APP_COOKIE_SECURE=false
APP_SECRET_KEY=development-only-change-before-deploy
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_OPENCV_THREADS=2
APP_MATCH_THRESHOLD=0.50
APP_MATCH_MARGIN=0.08
APP_QUEUE_CAPACITY=32
